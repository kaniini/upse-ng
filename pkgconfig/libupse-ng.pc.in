prefix=@PREFIX@
exec_prefix=@EXEC_PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: libupse-ng
Description: PlayStation game-music module playback library
Version: @VERSION@
Libs: -L${libdir} -lupse-ng
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
